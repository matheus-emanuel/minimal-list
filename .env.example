# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used exclusively by offline seed/migration scripts, never at runtime in the app
SUPABASE_SERVICE_ROLE_KEY=

# Badge upload limits (defaults shown — see DESIGN_COURSE_TRACKER.md Configuration section)
BADGE_MAX_FILE_SIZE_MB=5
BADGE_MAX_UPLOADS_PER_DAY=10
BADGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# E2E tests (tests/e2e) — credentials for a seeded regular user and a seeded sysadmin
E2E_BASE_URL=http://localhost:3000
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
